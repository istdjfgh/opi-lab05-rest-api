          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"є кількість замовлень і товарів\", () => { const b = pm.response.json(); pm.expect(b.orders).to.be.a(\"number\"); pm.expect(b.products).to.eql(12); });"
                ]
              }
            }
          ]
        }
