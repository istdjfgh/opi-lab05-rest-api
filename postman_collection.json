        {
          "name": "GET /health — сервіс працює",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Відповідь у JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"status = ok\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\"ok\"); });",
                  "pm.test(\"v1 позначена як попередня версія\", () => pm.expect(pm.response.headers.get(\"Deprecation\")).to.eql(\"true\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /stats без ключа → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"є текст помилки\", () => { const b = pm.response.json(); pm.expect(b.error).to.include(\"X-API-Key\"); });"
                ]
              }
            }
          ]
